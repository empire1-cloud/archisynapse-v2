# Development database
POSTGRES_DB=archisynapse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Required before the gateway can create merchants.
# Use a long random value. Do not commit the real value.
ARCHISYNAPSE_ADMIN_TOKEN=

# Required before the gateway can encrypt internal merchant credentials.
# This must be a URL-safe base64 encoding of exactly 32 random bytes.
# Generate one with:
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
ARCHISYNAPSE_GATEWAY_MASTER_KEY=
ARCHISYNAPSE_GATEWAY_KEY_ID=gateway-v1

# Optional but required for signed payment receipts.
# Generate a separate 32-byte seed; never reuse the gateway encryption key.
ARCHISYNAPSE_RECEIPT_SIGNING_PRIVATE_KEY=
ARCHISYNAPSE_RECEIPT_SIGNING_KEY_ID=receipt-v1

# Payment processor boundary. Disabled by default.
# stripe_test requires sk_test_.
# stripe_live_smoke requires sk_live_ plus both explicit guards below and then
# permits exactly one $1.00 USD charge/refund path.
ARCHISYNAPSE_PROCESSOR=disabled
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_API_BASE_URL=https://api.stripe.com/v1
ARCHISYNAPSE_LIVE_SMOKE_TEST_ENABLED=false
ARCHISYNAPSE_LIVE_SMOKE_TEST_CONFIRM=

# Used only by the local browser smoke-test runner. Never commit the real key.
ARCHISYNAPSE_MERCHANT_API_KEY=
ARCHISYNAPSE_GATEWAY_URL=http://127.0.0.1:9000

# Used by the fraud and analytics services for protected stored values.
ARCHISYNAPSE_PEPPER=

# Royalty processing remains off unless explicitly enabled and configured.
ROYALTY_LOOP_ENABLED=false
ROYALTY_ADMIN_TOKEN=
ROYALTY_TEST_FIXTURES_ENABLED=false
